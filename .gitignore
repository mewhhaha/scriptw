*.wasm
# Test262 runs write a `.txt` summary beside every snapshot JSON. Only the
# publication pairs are tracked: the published status generation and the
# aggregate it names. Text files elsewhere are ordinary sources.
/test262/snapshots/**/*.txt
!/test262/snapshots/published-status-wasm-aot*.txt
!/test262/snapshots/*-aggregate-*.txt
# Run droppings: per-case child snapshots and default-named (`latest`) runs.
/test262/snapshots/**/*-case-*
/test262/snapshots/**/latest-*
# Cited as evidence by crates/scriptw-ir/src/lowering.rs.
!/test262/snapshots/latest-5052292535410439978.json
# Abandoned run families that nothing reads.
/test262/snapshots/codex-debug-phase3j*
/test262/snapshots/codex-published-wasm-aot-next*
# `test262 backlog` writes test262/backlog/<test262 revision>/<backend>.json
# and its rendered `.txt` summary together. Both halves of a generated pair
# are tracked, like the publication pairs above; this negation only records
# that no `.txt` rule may hide them.
!/test262/backlog/*/*.txt
__pycache__/
*.py[cod]
*.exe

.claude
node_modules/
pnpm-lock.yaml
target/
# Local source-recovery snapshots and verification logs are not product inputs.
/.scriptw-task-work/

# Preserve the complete official Test262 tree, including text and binary fixtures.
!/test262/vendor/test262/**

# Adjacent staged generator outputs; recovery journals live under target/.
.scriptw-generated-*
